---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="foot" id="contact" data-week="52" data-sec="Contact">
  <div class="grid">
    <p class="foot__big display">In balance.</p>
    <div class="foot__row">
      <div class="foot__cta">
        <h2 class="label" style="color:#aeb3b9;margin-bottom:1rem">Contact</h2>
        <a class="btn" href={`mailto:${site.email}`} data-fill><span class="btn__fill" aria-hidden="true"></span>Email me<span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
      <ul class="foot__links" role="list" style="list-style:none;padding:0">
        {site.socials.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div class="foot__small">
      <span>© {year} {site.name}</span>
      <span>Charts are illustrative and contain no program data.</span>
      <span>Set in Archivo and IBM Plex Mono</span>
    </div>
  </div>
</footer>
